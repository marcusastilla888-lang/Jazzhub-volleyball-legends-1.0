-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Load Redz UI Library
local RedzLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/tbao143/Library/main/RedzLib"))()

-- Create Window
local Window = RedzLib:MakeWindow({
    Title = "Jazzhub | Volleyball Legends",
    SubTitle = "v1.1.0 - Working Edition",
    SaveFolder = "JazzhubVolleyballConfigs"
})

-- Notification
RedzLib:MakeNotification({
    Title = "Jazzhub Loaded!",
    Text = "All automation and ball-tracking loops are active.",
    Time = 5
})

-- Configuration & State Settings
local Config = {
    AutoHit = false,
    AutoServe = false,
    AutoTrain = false,
    SelectedTraining = "Power",
    HitDistance = 15 -- Studs range to trigger hit
}

-- Safe Remote Helper for Volleyball Legends
local function FireRemote(remoteName, ...)
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Net")
        if remotes and remotes:FindFirstChild(remoteName) then
            local remote = remotes[remoteName]
            if remote:IsA("RemoteEvent") then
                remote:FireServer(...)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(...)
            end
        end
    end)
end

-- Helper to find the volleyball in the workspace
local function FindBall()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name:lower():find("ball") and obj:IsA("BasePart") then
            return obj
        end
    end
    -- Check inside folders if not directly in workspace
    local ballsFolder = Workspace:FindFirstChild("Balls") or Workspace:FindFirstChild("Volleyballs")
    if ballsFolder then
        for _, obj in ipairs(ballsFolder:GetChildren()) do
            if obj:IsA("BasePart") then
                return obj
            end
        end
    end
    return nil
end

